{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linen",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linen",
      "database_id": "local-linen",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "linen-attachments"
    }
  ],
  "vars": {
    "AUTH_LOCAL": "false",
    "AUTH_ORIGIN": "",
    "MAIL_PROVIDER": "",
    "MAIL_FROM": "",
    "MAIL_RELAY_URL": "",
    "MAIL_ACCOUNT_ID": "",
    "OWNER_EMAIL": ""
  }
}
